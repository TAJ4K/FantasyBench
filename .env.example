APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://fantasy:change-me@postgres:5432/fantasy
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-secret
ADMIN_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=

# Use fake for development and tests. Switching to openrouter never substitutes models.
LLM_PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_REQUESTS_PER_MINUTE=30
OPENROUTER_DAILY_BUDGET_USD=
OPENROUTER_SEASON_BUDGET_USD=
OPENROUTER_MAX_SINGLE_REQUEST_USD=
# Production must use a dedicated OpenRouter key/guardrail with an external spend limit.
OPENROUTER_PROVIDER_SPEND_LIMIT_CONFIRMED=false
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Fantasy Bench

DRAFT_REVEAL_MIN_DELAY_SECONDS=3
DRAFT_REVEAL_MAX_DELAY_SECONDS=8
AUTO_RESUME_DRAFT=true
DRAFT_RUNNER_LEASE_SECONDS=180
DRAFT_RUNNER_HEARTBEAT_SECONDS=15
MAX_TRADE_NEGOTIATION_ROUNDS=4
SCHEDULER_POLL_SECONDS=5
JOB_LEASE_SECONDS=600
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=30
LINEUP_REVIEW_HOURS_BEFORE_KICKOFF=48,3
WAIVER_COLLECTION_HOURS_BEFORE_DEADLINE=2
WAIVER_PERIOD_HOURS=24
WAIVER_PROCESSING_GRACE_MINUTES=30
TRADE_REVIEW_INTERVAL_HOURS=24
